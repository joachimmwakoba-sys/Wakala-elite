<!DOCTYPE html>
<html lang="sw">
<head>
    <meta charset="UTF-8">
    <title>WAKALA-TRACK ELITE v40.0 | Final Master</title>
    <style>
        :root { --primary: #FFD700; --dark: #050505; --card: #121212; --success: #00e676; --danger: #ff4444; --text: #f0f0f0; }
        body { font-family: 'Inter', sans-serif; margin: 0; background: var(--dark); color: var(--text); display: flex; height: 100vh; overflow: hidden; }
        
        /* LAYOUT */
        .sidebar { width: 260px; background: #000; border-right: 1px solid #222; display: flex; flex-direction: column; }
        .brand { padding: 30px; background: var(--primary); color: black; font-weight: 900; text-align: center; font-size: 1.3rem; }
        .main { flex-grow: 1; overflow-y: auto; padding: 30px; }

        /* ANALYTICS */
        .grand-analytics { background: #111; padding: 25px; border-radius: 20px; border: 1px solid #333; margin-bottom: 25px; border-left: 10px solid var(--primary); display: flex; justify-content: space-between; align-items: center; }
        
        /* CARDS */
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 20px; }
        .shop-card { background: var(--card); border-radius: 25px; padding: 25px; border: 1px solid #222; position: relative; }
        
        /* TABLES */
        table { width: 100%; margin-top: 15px; border-collapse: collapse; font-size: 0.85rem; }
        th { text-align: left; color: #555; padding-bottom: 8px; border-bottom: 1px solid #222; }
        td { padding: 12px 0; border-bottom: 1px solid #1a1a1a; }

        /* BUTTONS */
        .btn { width: 100%; padding: 14px; border-radius: 12px; border: none; font-weight: 900; cursor: pointer; margin-top: 10px; transition: 0.3s; }
        .btn-p { background: var(--primary); color: black; }
        .btn-s { background: #222; color: white; }
        .btn-tiny { padding: 5px 10px; font-size: 0.7rem; border-radius: 6px; cursor: pointer; border: 1px solid #444; background: none; color: #888; }

        /* MODALS */
        .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.9); z-index: 1000; display: none; align-items: center; justify-content: center; backdrop-filter: blur(8px); }
        .modal-content { background: #111; padding: 30px; border-radius: 25px; width: 400px; border: 1px solid #333; }
        input { width: 100%; padding: 12px; margin: 8px 0; background: #000; border: 1px solid #333; color: white; border-radius: 10px; box-sizing: border-box; }

        @media print { .sidebar, .btn-tiny, .btn-s { display: none !important; } .main { padding: 0; } .shop-card { border: 1px solid #ccc; color: black; background: white; } body { background: white; color: black; } }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="brand">ELITE v40.0</div>
        <div style="padding: 20px;">
            <button class="btn btn-p" onclick="openReg()">🏪 SAJILI DUKA JIPYA</button>
            <button class="btn btn-s" onclick="window.print()">📥 PDF REPORT</button>
            <button class="btn btn-s" onclick="logout()" style="margin-top:50px;">🔴 LOGOUT</button>
        </div>
        <div style="margin-top:auto; padding:20px; text-align:center; color:#444; font-size:0.7rem;">COMMANDER: JEROME</div>
    </aside>

    <main class="main">
        <div class="grand-analytics">
            <div>
                <small style="color:#666; letter-spacing:1px;">TOTAL ENTERPRISE PROFIT</small>
                <h1 id="grand-total" style="margin:5px 0; color:var(--success); font-size:2.5rem;">TZS 0</h1>
            </div>
            <div style="text-align:right;">
                <span id="dateDisplay" style="color:#555; font-size:0.8rem;"></span>
            </div>
        </div>
        <div id="shopGrid" class="grid"></div>
    </main>

    <div id="mainModal" class="modal">
        <div class="modal-content">
            <h3 id="modalTitle" style="color:var(--primary); margin-top:0;"></h3>
            <div id="modalInputs"></div>
            <button class="btn btn-p" id="saveBtn">HIFADHI</button>
            <button class="btn btn-s" onclick="closeModal()">Funga</button>
        </div>
    </div>

    <script>
        const DB_KEY = 'JEROME_FINAL_V40';
        let db = JSON.parse(localStorage.getItem(DB_KEY)) || { shops: [] };
        let activeShopId = null;

        // --- COMMISSION ENGINE (Logic ya Mahesabu Halisi) ---
        function getComm(amt, net) {
            net = net.toUpperCase();
            // Mitandao ya Simu
            if(['VODA','AIRTEL','TIGO','HALO','TTCL'].some(n => net.includes(n))) {
                if(amt <= 1000) return 30;
                if(amt <= 10000) return 250;
                if(amt <= 100000) return 750;
                if(amt <= 1000000) return 4500;
                return amt * 0.005; // 0.5% kwa miamala mikubwa
            }
            // Mabenki (Fixed/Tiered)
            if(['NMB','CRDB','NBC','ACCESS'].some(n => net.includes(n))) {
                if(amt <= 100000) return 500;
                if(amt <= 1000000) return 1500;
                return 2500;
            }
            return amt * 0.005; // Default 0.5%
        }

        // --- CORE FUNCTIONS ---
        function openReg() {
            activeShopId = null;
            document.getElementById('modalTitle').innerText = "Sajili Duka Jipya";
            document.getElementById('modalInputs').innerHTML = `
                <input type="text" id="s_name" placeholder="Jina la Duka">
                <input type="text" id="s_net" placeholder="Mtandao wa Kwanza (Mf: VODA)">
                <input type="text" id="s_till" placeholder="Namba ya Till">
            `;
            document.getElementById('saveBtn').onclick = saveShop;
            document.getElementById('mainModal').style.display = 'flex';
        }

        function openAddSvc(id) {
            activeShopId = id;
            document.getElementById('modalTitle').innerText = "Ongeza Huduma Mpya";
            document.getElementById('modalInputs').innerHTML = `
                <input type="text" id="new_net" placeholder="Mtandao (Mf: NMB)">
                <input type="text" id="new_till" placeholder="Till Number">
            `;
            document.getElementById('saveBtn').onclick = addService;
            document.getElementById('mainModal').style.display = 'flex';
        }

        function saveShop() {
            const name = document.getElementById('s_name').value;
            const net = document.getElementById('s_net').value.toUpperCase();
            const till = document.getElementById('s_till').value;
            if(!name || !net) return;
            let shop = { id: Date.now(), name, tills: {}, bal: {}, profits: {} };
            shop.tills[net] = till; shop.bal[net] = 0; shop.profits[net] = 0;
            db.shops.push(shop); sync(); closeModal();
        }

        function addService() {
            const net = document.getElementById('new_net').value.toUpperCase();
            const till = document.getElementById('new_till').value;
            const shop = db.shops.find(s => s.id === activeShopId);
            if(shop && net) {
                shop.tills[net] = till; shop.bal[net] = 0; shop.profits[net] = 0;
                sync(); closeModal();
            }
        }

        function removeSvc(id, net) {
            if(confirm(`Futa huduma ya ${net}?`)) {
                const shop = db.shops.find(s => s.id === id);
                delete shop.tills[net]; delete shop.bal[net]; delete shop.profits[net];
                sync();
            }
        }

        // SIMULATOR YA SMS (Kwa ajili ya Testing yako Jerome)
        function testSMS(smsBody) {
            db.shops.forEach(shop => {
                for(let net in shop.tills) {
                    if(smsBody.includes(shop.tills[net])) {
                        const amt = parseInt(smsBody.match(/\d+/)[0]);
                        if(smsBody.includes("received") || smsBody.includes("weka")) {
                            shop.bal[net] += amt;
                        } else {
                            if(shop.bal[net] >= amt) {
                                shop.bal[net] -= amt;
                                shop.profits[net] += getComm(amt, net);
                            }
                        }
                    }
                }
            });
            sync();
        }

        function sync() { localStorage.setItem(DB_KEY, JSON.stringify(db)); render(); }
        function closeModal() { document.getElementById('mainModal').style.display = 'none'; }
        function logout() { location.reload(); }

        function render() {
            const grid = document.getElementById('shopGrid');
            grid.innerHTML = "";
            let grandTotal = 0;
            document.getElementById('dateDisplay').innerText = new Date().toLocaleDateString('sw-TZ', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

            db.shops.forEach(s => {
                let shopProfit = 0;
                let rows = "";
                for(let net in s.tills) {
                    const p = s.profits[net] || 0;
                    shopProfit += p;
                    rows += `
                        <tr>
                            <td style="color:var(--primary); font-weight:bold;">${net}</td>
                            <td>${s.bal[net].toLocaleString()}</td>
                            <td style="color:var(--success); font-weight:bold;">+ ${p.toLocaleString()}</td>
                            <td style="text-align:right;"><button class="btn-tiny" onclick="removeSvc(${s.id}, '${net}')" style="color:var(--danger); border-color:var(--danger);">Futa</button></td>
                        </tr>`;
                }
                grandTotal += shopProfit;
                grid.innerHTML += `
                    <div class="shop-card">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <h3 style="margin:0; color:var(--primary);">${s.name}</h3>
                            <button class="btn-tiny" onclick="openAddSvc(${s.id})">+ Huduma</button>
                        </div>
                        <table>
                            <thead><tr><th>Mtandao</th><th>Salio</th><th>Faida</th><th></th></tr></thead>
                            <tbody>${rows}</tbody>
                        </table>
                        <div style="margin-top:20px; padding:15px; background:#000; border-radius:15px; border:1px solid #333; display:flex; justify-content:space-between; align-items:center;">
                            <small style="color:#666;">SHOP TOTAL PROFIT:</small>
                            <b style="color:var(--success); font-size:1.2rem;">TZS ${shopProfit.toLocaleString()}</b>
                        </div>
                    </div>`;
            });
            document.getElementById('grand-total').innerText = "TZS " + grandTotal.toLocaleString();
        }
        render();
    </script>
</body>
</html>
